# Переменные окружения личного кабинета.
# Локально: скопируйте в .env и заполните. На сервере: /var/www/azimut/.env (см. docs/DEPLOY.md).
# Файл .env в git не попадает.

# Ключ шифрования cookie сессии, не короче 32 символов: openssl rand -base64 48
NUXT_SESSION_PASSWORD=

# База логин-сервера (accounts, master_accounts, платежи, рефералы)
NUXT_DB_HOST=
NUXT_DB_PORT=3306
NUXT_DB_USER=
NUXT_DB_PASSWORD=
NUXT_DB_DATABASE=la2

# Игровые БД (имя базы = id сервера из shared/cabinet.ts). Пусто — те же доступы, что и NUXT_DB_*
NUXT_GAME_DB_HOST=
NUXT_GAME_DB_PORT=
NUXT_GAME_DB_USER=
NUXT_GAME_DB_PASSWORD=

# Проверка онлайна для /api/status: TCP-порт входа в игру.
# Пусто — хост берётся из NUXT_GAME_DB_HOST, иначе из NUXT_DB_HOST; порт по умолчанию 7778.
# NUXT_GAME_SERVER_HOST=
# NUXT_GAME_SERVER_PORT=7778

# Логины мастер-аккаунтов с доступом к админ-панели, через запятую
NUXT_ADMIN_LOGINS=admin

# Ссылка СБП для оплаты — на неё ведёт QR на странице пополнения.
# Не задана — используется ссылка из nuxt.config.ts (runtimeConfig.sbpPaymentUrl).
# NUXT_SBP_PAYMENT_URL=https://c2c.cbrpay.ru/BS1I0000E4C1IOK88SOA7IUC9BB3C9KL

# Платёжный шлюз: карты Visa/Mastercard, карты Мир, СБП, ЕРИП.
# Пока не заполнено — счета создаются с ручным подтверждением оператором.
# NUXT_PAYMENTS_GATEWAY_URL=
# NUXT_PAYMENTS_MERCHANT_ID=
# NUXT_PAYMENTS_SECRET=
# NUXT_PAYMENTS_CALLBACK_URL=https://l2azimut.ru/api/payments/callback
#
# 1 терминал = 1 касса: у каждого способа оплаты своя пара terminal_id/cashbox_id.
# NUXT_PAYMENTS_CARD_INTL_TERMINAL_ID=
# NUXT_PAYMENTS_CARD_INTL_CASHBOX_ID=
# NUXT_PAYMENTS_CARD_RU_TERMINAL_ID=
# NUXT_PAYMENTS_CARD_RU_CASHBOX_ID=
# NUXT_PAYMENTS_SBP_TERMINAL_ID=
# NUXT_PAYMENTS_SBP_CASHBOX_ID=
# NUXT_PAYMENTS_ERIP_TERMINAL_ID=
# NUXT_PAYMENTS_ERIP_CASHBOX_ID=
#
# Сколько рублей стоит 1 белорусский рубль для счетов ЕРИП (по умолчанию 28)
# NUXT_PAYMENTS_ERIP_RUB_PER_BYN=28

# Новый личный кабинет. false — ссылки на кабинет ведут в старую CMS (так собирается статика для FTP)
# NUXT_PUBLIC_CABINET_ENABLED=true

# Адрес сайта для SEO и реферальных ссылок (без слеша в конце)
# NUXT_PUBLIC_I18N_BASE_URL=https://l2azimut.ru
