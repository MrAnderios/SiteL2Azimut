# Переменные окружения личного кабинета.
# Локально: скопируйте в .env и заполните. На сервере: /var/www/azimut/.env (см. docs/DEPLOY.md).
# Файл .env в git не попадает.

# Ключ шифрования cookie сессии, не короче 32 символов: openssl rand -base64 48
NUXT_SESSION_PASSWORD=

# База логин-сервера (accounts, master_accounts, платежи, рефералы)
NUXT_DB_HOST=
NUXT_DB_PORT=3306
NUXT_DB_USER=
NUXT_DB_PASSWORD=
NUXT_DB_DATABASE=la2

# Игровые БД (имя базы = id сервера из shared/cabinet.ts). Пусто — те же доступы, что и NUXT_DB_*
NUXT_GAME_DB_HOST=
NUXT_GAME_DB_PORT=
NUXT_GAME_DB_USER=
NUXT_GAME_DB_PASSWORD=

# Логины мастер-аккаунтов с доступом к админ-панели, через запятую
NUXT_ADMIN_LOGINS=admin

# Новый личный кабинет. false — ссылки на кабинет ведут в старую CMS (так собирается статика для FTP)
# NUXT_PUBLIC_CABINET_ENABLED=true

# Адрес сайта для SEO и реферальных ссылок (без слеша в конце)
# NUXT_PUBLIC_I18N_BASE_URL=https://l2azimut.ru
